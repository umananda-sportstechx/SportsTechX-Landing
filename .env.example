# Beehiiv newsletter. /api/newsletter subscribes the address through the Beehiiv
# API (send_welcome_email + reactivate_existing). Unset, the signup form falls
# back to opening the hosted Beehiiv subscribe page with the email pre-filled.
# Key: Beehiiv -> Settings -> API. Publication id: the "pub_..." id.
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# STX backend, for the CMS-managed partner photos and testimonials
# (admin panel -> Site assets -> STX landing). Unset, both sections fall back
# to the content decoded from the .fig.
BACKEND_URL=http://localhost:5000
