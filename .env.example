# Where newsletter signups are forwarded (Mailchimp / Beehiiv / Zapier catch hook / …).
# The route POSTs {"email": "...", "source": "landing"} as JSON.
# Unset, /api/subscribe returns 501 rather than silently dropping the address.
NEWSLETTER_WEBHOOK_URL=

# STX backend, for the CMS-managed partner photos and testimonials
# (admin panel -> Site assets -> STX landing). Unset, both sections fall back
# to the content decoded from the .fig.
BACKEND_URL=http://localhost:5000
